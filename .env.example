# Credenciais do administrador (criadas no primeiro acesso ao banco).
# Copie para .env.local e altere ANTES de publicar.
ADMIN_EMAIL=gilvandro3008@gmail.com
ADMIN_PASSWORD=clara3008

# Segredo para assinar a sessão. Se vazio, é gerado em data/.session-secret.
SESSION_SECRET=

# Defina como "true" quando o sistema estiver na Vercel/nuvem com HTTPS.
COOKIE_SECURE=false

# Banco de dados em nuvem (GRATUITO com Turso - https://turso.tech)
# Deixe vazio para rodar localmente com SQLite (./data/gf.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# API de Envio Automático de WhatsApp (Evolution API, Z-API ou compatível)
# Envia mensagens, proposta em PDF e logotipo diretamente pelo WhatsApp da empresa sem abrir o aplicativo
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_INSTANCE=gfdedetizacao

# Disparo Automático de E-mail:
# OPÇÃO 1: Gmail / SMTP (100% Gratuito - envia para QUALQUER cliente sem precisar de domínio próprio)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# OPÇÃO 2: Resend API (Exige domínio verificado em resend.com/domains para enviar a terceiros)
RESEND_API_KEY=
EMAIL_FROM="GF Dedetização <onboarding@resend.dev>"

# Caminho do banco SQLite local (opcional, padrão: ./data/gf.db)
# DATABASE_PATH=./data/gf.db
